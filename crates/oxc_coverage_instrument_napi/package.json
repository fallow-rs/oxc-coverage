{
  "name": "oxc-coverage-instrument",
  "version": "0.15.0",
  "description": "Istanbul-compatible JavaScript/TypeScript coverage instrumentation using the Oxc AST.",
  "main": "index.js",
  "browser": "browser.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "browser": "./browser.js",
      "default": "./index.js"
    },
    "./vitest": {
      "types": "./vitest.d.ts",
      "default": "./vitest.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "browser.js",
    "coverage-instrument.wasi.cjs",
    "coverage-instrument.wasi-browser.js",
    "wasi-worker.mjs",
    "wasi-worker-browser.mjs",
    "vitest.js",
    "vitest.d.ts"
  ],
  "keywords": [
    "oxc",
    "istanbul",
    "coverage",
    "javascript",
    "typescript",
    "instrumentation",
    "code-coverage"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fallow-rs/oxc-coverage-instrument.git",
    "directory": "crates/oxc_coverage_instrument_napi"
  },
  "homepage": "https://github.com/fallow-rs/oxc-coverage-instrument",
  "bugs": "https://github.com/fallow-rs/oxc-coverage-instrument/issues",
  "napi": {
    "binaryName": "coverage-instrument",
    "packageName": "@oxc-coverage-instrument/binding",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "wasm32-wasip1-threads"
    ],
    "wasm": {
      "optionalDependency": true
    }
  },
  "dependencies": {
    "@emnapi/core": "2.0.0-beta.2",
    "@emnapi/runtime": "2.0.0-beta.2",
    "@napi-rs/wasm-runtime": "^1.2.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0 || ^8.0.0",
    "@jridgewell/gen-mapping": "^0.3.13",
    "@napi-rs/cli": "3.10.8",
    "emnapi": "2.0.0-beta.2",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-instrument": "^6.0.3",
    "istanbul-lib-source-maps": "^5.0.6"
  },
  "scripts": {
    "build": "napi build --release --platform && npm run patch-shim",
    "build:debug": "napi build --platform && npm run patch-shim",
    "patch-shim": "node scripts/patch-wasi-emnapi-plugins.mjs && node scripts/patch-wasi-browser-shim.mjs && node scripts/patch-browser-loader.mjs",
    "prepublishOnly": "napi prepublish -t npm",
    "artifacts": "napi artifacts",
    "test": "node test.mjs && node scripts/patch-wasi-browser-shim.test.mjs && node scripts/patch-wasi-singlethreaded-artifacts.test.mjs && node scripts/patch-wasi-emnapi-plugins.test.mjs",
    "test:browser-loader": "node scripts/browser-loader.test.mjs"
  },
  "overrides": {
    "emnapi": "2.0.0-beta.2",
    "@emnapi/core": "2.0.0-beta.2",
    "@emnapi/runtime": "2.0.0-beta.2"
  },
  "optionalDependencies": {
    "@oxc-coverage-instrument/binding-darwin-arm64": "0.15.0",
    "@oxc-coverage-instrument/binding-darwin-x64": "0.15.0",
    "@oxc-coverage-instrument/binding-linux-arm64-gnu": "0.15.0",
    "@oxc-coverage-instrument/binding-linux-x64-gnu": "0.15.0",
    "@oxc-coverage-instrument/binding-linux-x64-musl": "0.15.0",
    "@oxc-coverage-instrument/binding-win32-arm64-msvc": "0.15.0",
    "@oxc-coverage-instrument/binding-win32-x64-msvc": "0.15.0",
    "@oxc-coverage-instrument/binding-wasm32-wasi": "0.15.0",
    "@oxc-coverage-instrument/binding-wasm32-wasi-singlethreaded": "0.15.0"
  }
}
