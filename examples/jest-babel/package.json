{
  "name": "oxc-coverage-instrument-jest-babel-example",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "coverage": "jest --coverage --no-cache",
    "coverage:istanbul": "COVERAGE_PLUGIN=istanbul jest --coverage --no-cache",
    "nyc": "nyc --report-dir coverage-nyc mocha",
    "nyc:istanbul": "COVERAGE_PLUGIN=istanbul nyc --temp-dir .nyc_output_istanbul --report-dir coverage-nyc-istanbul mocha",
    "verify": "node scripts/verify-coverage.mjs"
  },
  "nyc": {
    "all": true,
    "require": ["./test/register.js"],
    "include": ["src/**"],
    "extension": [".js", ".ts"],
    "sourceMap": false,
    "instrument": false,
    "reporter": ["json", "text"]
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-typescript": "^7.28.0",
    "@babel/register": "^7.28.0",
    "babel-jest": "^30.5.2",
    "babel-plugin-istanbul": "^8.0.0",
    "jest": "^30.5.2",
    "mocha": "^11.7.0",
    "nyc": "^17.1.0",
    "oxc-coverage-instrument": "file:../../crates/oxc_coverage_instrument_napi"
  }
}
